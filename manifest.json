{
  "manifest_version": 3,
  "name": "xfollow - 拒绝渣蓝",
  "version": "0.6.37",
  "description": "在你的关注里找出没回关你的、查出谁取关过你。纯本地运行,只读不写,不主动调用 X 接口。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "xfollow - 拒绝渣蓝（点一下开合侧边栏）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/main-world/tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/core/util.js",
        "src/content/extract.js",
        "src/core/snapshot.js",
        "src/core/ledger.js",
        "src/core/marks.js",
        "src/core/guard.js",
        "src/content/bridge.js",
        "src/content/scan.js",
        "src/content/sidebar.js",
        "src/content/badge.js",
        "src/content/worker.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
